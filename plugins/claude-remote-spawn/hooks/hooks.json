{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/claude-remote-spawn/sessions.py snapshot --quiet",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/claude-remote-spawn/sessions.py snapshot --quiet",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
